# Copy to .env and fill in only what you use. The API server reads it at start; real env vars win. Never commit .env. Placeholders only.

# --- optional LLM explanations (deterministic analysis works without these) ---
SHIELD_LLM_PROVIDER=none            # none | groq | anthropic
SHIELD_LLM_MODEL=                   # blank = provider default
GROQ_API_KEY=                       # e.g. gsk_... (development)
ANTHROPIC_API_KEY=                  # e.g. sk-ant-... (production)
SHIELD_LLM_TIMEOUT=20
SHIELD_LLM_RETRIES=2

# --- optional discovery search ---
SHIELD_SEARCH_PROVIDER=auto         # auto | brave | google_cse | serper | offline
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SERPER_API_KEY=

# --- safety / limits ---
SHIELD_LOCAL_ONLY=0                 # 1 = no remote LLM or search calls at all
SHIELD_API_TOKEN=                   # set to require "Authorization: Bearer <token>" on /api
SHIELD_HOST=127.0.0.1
SHIELD_PORT=8000
SHIELD_CORS_ORIGINS=http://localhost:5173
SHIELD_MAX_UPLOAD_MB=25
SHIELD_MAX_PDF_PAGES=200
SHIELD_MAX_TEXT_CHARS=200000
SHIELD_JOB_TTL_SECONDS=3600
SHIELD_MAX_JOBS=2
SHIELD_CRAWL_MAX_PAGES=100
SHIELD_CRAWL_MAX_DEPTH=3
SHIELD_CRAWL_RPS=1
SHIELD_CRAWL_TIMEOUT=300
SHIELD_FACE_REGIONS=1               # detect face regions so photos can be removed (no identification)
SHIELD_PERSONAS=PrivacyHawk,PragmaticDev,StatutoryAuditor,SwarmAdjudicator
SHIELD_PLAYWRIGHT_CHANNEL=             # e.g. chrome, when the bundled Playwright browser is missing
