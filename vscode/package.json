{
  "name": "shield-code",
  "displayName": "Shield\u00b7Code",
  "description": "Scan a workspace for secrets, Indian PII, unsafe code, risky config and sensitive images/documents; review and apply safe fixes with a preview.",
  "version": "0.5.0",
  "publisher": "aaron43210",
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AleenaAntony19/TEAMCARTEL_VYUHAM26.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/AleenaAntony19/TEAMCARTEL_VYUHAM26/tree/main/vscode#readme",
  "bugs": {
    "url": "https://github.com/AleenaAntony19/TEAMCARTEL_VYUHAM26/issues"
  },
  "keywords": [
    "security",
    "secrets",
    "privacy",
    "pii",
    "aadhaar",
    "redaction",
    "sast"
  ],
  "galleryBanner": {
    "color": "#17191B",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "shieldCode.scanWorkspace",
        "title": "Shield: Scan Workspace",
        "icon": "$(shield)"
      },
      {
        "command": "shieldCode.scanFile",
        "title": "Shield: Scan Current File"
      },
      {
        "command": "shieldCode.exportSarif",
        "title": "Shield: Export SARIF Report"
      },
      {
        "command": "shieldCode.showOutput",
        "title": "Shield: Show Log"
      },
      {
        "command": "shieldCode.previewFix",
        "title": "Shield: Preview Fix"
      },
      {
        "command": "shieldCode.explainFinding",
        "title": "Shield: Explain Finding with AI"
      },
      {
        "command": "shieldCode.revealFinding",
        "title": "Shield: Reveal Finding"
      },
      {
        "command": "shieldCode.deepScan",
        "title": "Shield: AI Deep Scan (asks before sending text)",
        "icon": "$(sparkle)"
      },
      {
        "command": "shieldCode.whyFlagged",
        "title": "Why flagged"
      },
      {
        "command": "shieldCode.pickFix",
        "title": "Fix\u2026"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shieldCode",
          "title": "Shield\u00b7Code",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "shieldCode": [
        {
          "id": "shieldCode.findings",
          "name": "Findings"
        },
        {
          "id": "shieldCode.ai",
          "name": "AI Provider",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "shieldCode.scanWorkspace",
          "when": "view == shieldCode.findings",
          "group": "navigation"
        },
        {
          "command": "shieldCode.deepScan",
          "when": "view == shieldCode.findings",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "shieldCode.pickFix",
          "when": "view == shieldCode.findings && viewItem == finding"
        },
        {
          "command": "shieldCode.whyFlagged",
          "when": "view == shieldCode.findings && viewItem == finding"
        }
      ],
      "commandPalette": [
        {
          "command": "shieldCode.whyFlagged",
          "when": "false"
        },
        {
          "command": "shieldCode.pickFix",
          "when": "false"
        },
        {
          "command": "shieldCode.previewFix",
          "when": "false"
        },
        {
          "command": "shieldCode.revealFinding",
          "when": "false"
        },
        {
          "command": "shieldCode.explainFinding",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Shield\u00b7Code",
      "properties": {
        "shieldCode.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Leave empty to use the engine bundled in the platform build. Developers: a Python interpreter with shield_scout requirements (then set enginePath)."
        },
        "shieldCode.enginePath": {
          "type": "string",
          "default": "",
          "description": "Folder that contains the `shield` package (the shield_scout checkout). Added to PYTHONPATH."
        },
        "shieldCode.engines": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "secrets",
              "pii",
              "sast",
              "config",
              "media",
              "document"
            ]
          },
          "default": [
            "secrets",
            "pii",
            "sast",
            "config",
            "media",
            "document"
          ]
        },
        "shieldCode.ocr.enabled": {
          "type": "boolean",
          "default": true,
          "description": "OCR images and embedded document images (needs tesseract)."
        },
        "shieldCode.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-scan a file (secrets + PII) when it is saved."
        },
        "shieldCode.maxFileSizeMB": {
          "type": "number",
          "default": 2,
          "minimum": 0.1,
          "maximum": 50
        },
        "shieldCode.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Globs on workspace-relative paths to skip (node_modules, .git, venvs are always skipped)."
        },
        "shieldCode.concurrency": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Analyzers run in parallel up to this many."
        },
        "shieldCode.timeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "maximum": 3600
        },
        "shieldCode.minSeverity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "default": "low"
        },
        "shieldCode.llm.provider": {
          "type": "string",
          "enum": [
            "none",
            "groq",
            "anthropic"
          ],
          "default": "none",
          "description": "Legacy: the AI Provider panel now stores this in extension storage. Keys are in Secret Storage, never in settings."
        },
        "shieldCode.llm.model": {
          "type": "string",
          "default": ""
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "package": "npm run build && vsce package --no-dependencies",
    "test:integration": "npm run build && node test/integration/run.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
